{
  "about": "The content server with CONTENT_DOWNLOAD_BASE_URL, no branding or news, and a metagame answering oddly (MIGRATION_PLAN.md S1).",
  "env": {
    "CONTENT_DOWNLOAD_BASE_URL": "https://downloads.example/game///"
  },
  "files": {
    "Version.txt": {
      "text": "test-build \r\n"
    },
    "Data/empty.log": {
      "text": ""
    },
    "Data/small.bin": {
      "pattern": 5000
    },
    "Data/changes.bin": {
      "text": "will be touched"
    },
    "Data/gone.bin": {
      "text": "will be deleted"
    },
    "Data/resized.bin": {
      "text": "will be resized"
    }
  },
  "gone": [
    "Data/gone.bin"
  ],
  "resized": {
    "Data/resized.bin": {
      "text": "now a different size"
    }
  },
  "extra": {
    "Data/not-in-manifest.bin": {
      "text": "secret"
    }
  },
  "keys": {
    "UUK_content_good_key_0123456789ab": {
      "status": 200,
      "body": "not json"
    }
  },
  "requests": [
    {
      "method": "GET",
      "path": "/content/v1/manifest",
      "headers": {}
    },
    {
      "method": "GET",
      "path": "/content/v1/files/Version.txt",
      "headers": {
        "x-undaunted-user-api-key": "UUK_content_good_key_0123456789ab"
      }
    },
    {
      "method": "GET",
      "path": "/content/v1/branding",
      "headers": {}
    },
    {
      "method": "GET",
      "path": "/content/v1/news",
      "headers": {}
    },
    {
      "method": "GET",
      "path": "/content/v1/branding/harbour.jpg",
      "headers": {}
    }
  ]
}
