{
  "about": "PARTY_SOLO_STUB=0 and ACCOUNT_DISPLAY_NAME=0 (MIGRATION_PLAN.md M29, area 5, second part).",
  "env": {
    "AUTH_MODE": "APIKEY",
    "NODE_ENV": "production",
    "PARTY_SOLO_STUB": "0",
    "ACCOUNT_DISPLAY_NAME": "0"
  },
  "gameServerKey": "test-gameserver-key-0123456789abcdef",
  "setup": [
    "INSERT INTO users (userId, name, notes, isAdmin) VALUES ('UID-a', 'Ada', 0, 0), ('UID-b', 'Bo', 0, 0), ('UID-c', 'Cy', 0, 0), ('UID-d', 'Di', 0, 0), ('UID-e', 'Ed', 0, 0), ('UID-f', 'Fi', 0, 0)",
    "INSERT INTO gameserverapikeys (keyHash) VALUES ('b42f983bfe5a4b2e0c1317fc96ea62cefb259ddbb2b3c2cbb1619c2faaafddff')",
    "INSERT INTO blocks (blockerId, blockedId, createdAt) VALUES ('UID-e', 'UID-a', 1700000000000)"
  ],
  "requests": [
    {
      "method": "POST",
      "path": "/party",
      "headers": {
        "authorization": "{{bearer:UID-a}}"
      },
      "capture": "partyId"
    },
    {
      "method": "PUT",
      "path": "/party/invite",
      "headers": {
        "authorization": "{{bearer:UID-a}}"
      },
      "json": {
        "recipientPlayerId": "UID-b"
      }
    },
    {
      "method": "GET",
      "path": "/party/invites",
      "headers": {
        "authorization": "{{bearer:UID-b}}"
      }
    },
    {
      "method": "PUT",
      "path": "/party/invite/accept/{{saved:partyId}}",
      "headers": {
        "authorization": "{{bearer:UID-b}}"
      }
    },
    {
      "method": "POST",
      "path": "/party",
      "headers": {
        "authorization": "{{bearer:UID-a}}"
      }
    },
    {
      "method": "POST",
      "path": "/party",
      "headers": {
        "authorization": "{{bearer:UID-c}}"
      }
    }
  ]
}
