{
  "about": "Slayer Links with SLAYER_LINKS=0: every route falls through to the 404 (MIGRATION_PLAN.md M29, area 6).",
  "env": {
    "AUTH_MODE": "APIKEY",
    "NODE_ENV": "production",
    "SLAYER_LINKS": "0"
  },
  "gameServerKey": "test-gameserver-key-0123456789abcdef",
  "setup": [
    "INSERT INTO users (userId, name, notes, isAdmin) VALUES ('UID-a', 'Ada', 0, 0), ('UID-b', 'Bo', 0, 0), ('UID-c', 'Cy', 0, 0), ('UID-d', 'Di', 0, 0), ('UID-e', 'Ed', 0, 0), ('UID-f', 'Fi', 0, 0)",
    "INSERT INTO gameserverapikeys (keyHash) VALUES ('b42f983bfe5a4b2e0c1317fc96ea62cefb259ddbb2b3c2cbb1619c2faaafddff')"
  ],
  "requests": [
    {
      "method": "GET",
      "path": "/slayerlink/status_good",
      "headers": {
        "authorization": "{{bearer:UID-a}}"
      }
    },
    {
      "method": "PUT",
      "path": "/slayerlink/invite",
      "headers": {
        "authorization": "{{bearer:UID-a}}"
      },
      "json": {
        "account_id": "UID-b",
        "slot": 1
      }
    },
    {
      "method": "POST",
      "path": "/slayerlink/availability",
      "headers": {
        "authorization": "{{bearer:UID-a}}"
      },
      "json": {
        "account_ids": [
          "UID-b"
        ]
      }
    },
    {
      "method": "DELETE",
      "path": "/slayerlink/links",
      "headers": {
        "authorization": "{{bearer:UID-a}}"
      },
      "json": {
        "slot": 1
      }
    }
  ]
}
