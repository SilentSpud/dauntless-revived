  "finalQueries": [
    "SELECT json_group_array(json_object('account_id', account_id, 'reason', reason, 'address', address, 'active', active, 'actor', actor, 'expires', expires_at IS NOT NULL)) AS j FROM (SELECT * FROM account_bans ORDER BY account_id)",
    "SELECT json_group_array(json_object('id', id, 'account_id', account_id, 'reason', reason, 'address', address, 'active', active)) AS j FROM (SELECT * FROM moderation_events ORDER BY id)",
    "SELECT json_group_array(json_object('account_id', account_id, 'kind', kind, 'hash', signal_hash)) AS j FROM (SELECT * FROM account_device_signals ORDER BY account_id, kind)",
    "SELECT json_group_array(json_object('account_id', account_id, 'kind', kind, 'hash', signal_hash)) AS j FROM (SELECT * FROM device_ban_signals ORDER BY account_id, kind)"
  ]
}
