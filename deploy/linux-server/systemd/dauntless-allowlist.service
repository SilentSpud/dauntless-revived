[Unit]
Description=Dauntless Revived nftables allowlist
After=network-online.target
Wants=network-online.target
Before=dauntless-gateway.service

[Service]
Type=simple
User=root
WorkingDirectory=@ROOT@
ExecStart=@ROOT@/bin/allowlist --env-file=@CONFIG@/allowlist.env
ExecStopPost=@ROOT@/bin/allowlist --env-file=@CONFIG@/allowlist.env --close-ports
Restart=on-failure
RestartSec=3
KillSignal=SIGTERM
TimeoutStopSec=20

[Install]
WantedBy=multi-user.target
