[Unit]
Description=Dauntless Revived public TLS gateway
After=network-online.target dauntless-metagame.service dauntless-content.service dauntless-allowlist.service
Wants=network-online.target
Requires=dauntless-metagame.service dauntless-content.service dauntless-allowlist.service

[Service]
Type=simple
User=@USER@
WorkingDirectory=@ROOT@
ExecStart=@ROOT@/bin/gateway serve --env-file=@CONFIG@/gateway.env
Restart=on-failure
RestartSec=3
KillSignal=SIGTERM
TimeoutStopSec=20
AmbientCapabilities=CAP_NET_BIND_SERVICE
CapabilityBoundingSet=CAP_NET_BIND_SERVICE
NoNewPrivileges=true
LimitNOFILE=65536

[Install]
WantedBy=multi-user.target
