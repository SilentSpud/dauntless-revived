[Unit]
Description=Dauntless Revived metagame
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=@USER@
WorkingDirectory=@ROOT@/UndauntedMetagame
ExecStart=@ROOT@/bin/metagame serve --env-file=@CONFIG@/metagame.env
Restart=on-failure
RestartSec=3
KillSignal=SIGTERM
TimeoutStopSec=20
LimitNOFILE=65536

[Install]
WantedBy=multi-user.target
