[Unit]
Description=Dauntless Revived content server
After=network-online.target dauntless-metagame.service
Wants=network-online.target
Requires=dauntless-metagame.service

[Service]
Type=simple
User=@USER@
WorkingDirectory=@ROOT@
ExecStart=@ROOT@/bin/content serve --env-file=@CONFIG@/content.env
Restart=on-failure
RestartSec=3
KillSignal=SIGTERM
TimeoutStopSec=20
LimitNOFILE=65536

[Install]
WantedBy=multi-user.target
