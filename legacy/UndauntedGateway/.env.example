# Dauntless Revived gateway settings, for both processes in this folder (public mode only):
#   npm start                  the public TLS gateway     (dist/server.js)
#   npm run start:allowlist    the allowlist helper       (dist/allowlist/server.js)
# Both read .env in this folder if it exists; variables already set in your shell win over it. On a
# server the Windows server kit gives each process its own file (gateway.env and allowlist.env).
# Copy this file to .env and fill in the empty values. Restart a process after any change.
#
# The values below are for development on one PC: loopback only, and the helper in dry-run mode,
# so Windows Firewall is never touched. Lines starting with # show the default; leave them out to
# get it. docs/reference/configuration.md explains every line; README.md explains the routing and
# how the limits were sized.
# .env holds secrets: never share it, never commit it (it is git-ignored).
# Generate each secret (64 hex characters) with:
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"

# ================================================================== gateway (dist/server.js)

# Address of the TLS listener, an IP address. Default 0.0.0.0 (IPv4, what a server uses).
GATEWAY_BIND=127.0.0.1
# TLS port, and the port in public invites. Default 443 (what a server uses).
GATEWAY_PORT=61443
# PEM certificate and its private key. Required, no default. Make both with
#   node tools/make-cert.js --host 127.0.0.1 --out <a folder outside the repository>
# The key file is SECRET: never share it, never commit it.
GATEWAY_CERT=
GATEWAY_KEY=
# SECRET: never share, never commit. Sent to the metagame as X-Dauntless-Gateway; must equal the
# metagame's GATEWAY_SECRET. 32-256 printable characters, no spaces. Required.
GATEWAY_SECRET=
# Upstreams: http://host:port on this machine only (127.x.x.x, ::1 or localhost), no path.
# GATEWAY_METAGAME_URL=http://127.0.0.1:61000
# GATEWAY_CONTENT_URL=http://127.0.0.1:61002
# GATEWAY_WS_URL=http://127.0.0.1:61099
# The allowlist feed. Default on; exactly 0 turns it off, and then no player's game ports open.
# GATEWAY_ALLOWLIST=0
# Where the gateway reports logged-in players' addresses (the helper below).
# ALLOWLIST_URL=http://127.0.0.1:61005
# The gateway also needs ALLOWLIST_SECRET (unless GATEWAY_ALLOWLIST=0). In this shared .env both
# processes read the one ALLOWLIST_SECRET line in the helper's section below.
# An address the helper accepted is re-sent at most this often, in seconds (5-540). Default 60.
# GATEWAY_ALLOWLIST_REFRESH_SECONDS=60

# Limits.
# Largest request body in bytes (1024-67108864). Default 131072.
# GATEWAY_MAX_BODY_BYTES=131072
# Open connections in total (1-100000). Default 2048.
# GATEWAY_MAX_CONNECTIONS=2048
# Open connections per IPv4 address or IPv6 /64 (1-100000). Default 128.
# GATEWAY_MAX_CONNECTIONS_PER_IP=128

# Rate limits per IPv4 address or IPv6 /64, as "<burst>,<per minute>".
# All game traffic not covered below. Default 300,180.
# GATEWAY_RATE_GENERAL=300,180
# /content downloads. Default 600,600.
# GATEWAY_RATE_CONTENT=600,600
# Account creation. Default 5,0.2 (five at once, then one every five minutes).
# GATEWAY_RATE_REGISTER=5,0.2
# Logins. Default 10,1.
# GATEWAY_RATE_TOKEN=10,1
# WebSocket upgrades (the game's chat connection), apart from the rest. Default 20,12.
# GATEWAY_RATE_WS=20,12
# New TCP connections. Default 200,300.
# GATEWAY_RATE_CONNECT=200,300

# Timeouts in milliseconds.
# TLS handshake (1000-120000). Default 10000.
# GATEWAY_HANDSHAKE_TIMEOUT_MS=10000
# A request's headers (1000-120000). Default 10000.
# GATEWAY_HEADERS_TIMEOUT_MS=10000
# A whole request, body included (1000-600000). Default 30000.
# GATEWAY_REQUEST_TIMEOUT_MS=30000
# Idle keep-alive between requests (1000-600000). Default 65000.
# GATEWAY_KEEPALIVE_TIMEOUT_MS=65000
# A client connection that moves no data (1000-3600000). Default 120000.
# GATEWAY_IDLE_TIMEOUT_MS=120000
# A silent upstream request (1000-3600000). Default 120000.
# GATEWAY_UPSTREAM_IDLE_TIMEOUT_MS=120000
# An idle joined WebSocket (1000-86400000). Default 300000.
# GATEWAY_WS_IDLE_TIMEOUT_MS=300000
# Time requests in flight get to finish on a stop (0-300000). Default 10000.
# GATEWAY_SHUTDOWN_GRACE_MS=10000

# ================================================================== allowlist helper (dist/allowlist/server.js)

# Required, no default. 1: never touch the firewall, only write what it would do to the audit log
# (every machine that is not the server). 0: really change Windows Firewall (needs administrator
# rights). Never 0 on a development PC.
ALLOWLIST_DRY_RUN=1
# Listen address, 127.0.0.1 or ::1 only. Default 127.0.0.1.
# ALLOWLIST_BIND=127.0.0.1
# Listen port; must match ALLOWLIST_URL above. Default 61005.
# ALLOWLIST_PORT=61005
# SECRET: never share, never commit. Shared with the gateway (see above). 32-256 printable
# characters, no spaces. Required.
ALLOWLIST_SECRET=
# The game servers' UDP ports the firewall rule opens: one port or low-high. Default 8770-8777.
# ALLOWLIST_PORTS=8770-8777
# How long an address stays open after its last report, in seconds (1-86400). Default 600.
# ALLOWLIST_TTL_SECONDS=600
# Minimum time between two firewall rule changes, in ms (50-600000). Default 3000.
# ALLOWLIST_MIN_INTERVAL_MS=3000
# Most addresses open at once (1-1000). Default 256.
# ALLOWLIST_MAX_ENTRIES=256
# Audit log and saved state; both hold player IP addresses. Defaults allowlist-audit.log and
# allowlist-state.json in the folder the helper starts in (both git-ignored here).
# ALLOWLIST_AUDIT_LOG=allowlist-audit.log
# ALLOWLIST_STATE_FILE=allowlist-state.json
# Exactly 1 also accepts private, Tailscale, loopback and link-local addresses. Default off.
# Development and LAN only (a player on 127.0.0.1 needs it); never on a public server.
ALLOWLIST_ALLOW_PRIVATE=1
# The PowerShell the helper runs, as administrator, for every firewall change. Leave it unset.
# Default %SystemRoot%\System32\WindowsPowerShell\v1.0\powershell.exe.
# ALLOWLIST_POWERSHELL=

# ================================================================== both processes

# debug, info, warn or error. Default info. debug also logs failed TLS handshakes.
# LOG_LEVEL=info
# Additional worker allowlist helpers, comma-separated loopback SSH tunnel URLs (maximum 3).
# ALLOWLIST_ADDITIONAL_URLS=http://127.0.0.1:61015
